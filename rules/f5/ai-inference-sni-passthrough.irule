# Generated by tools/generate.py from catalog/catalog.json. Do not edit by hand.
# AI inference egress iRule for BIG-IP virtual servers that forward TLS without a client SSL profile.
# Parses the TLS ClientHello server_name extension from the first client record and rejects matches.
# Requires the data groups from ai-inference-datagroups.tmsh. Attach to a standard TCP virtual server.

proc ai_inference_host_blocked { host } {
    set host [string trimright [string tolower $host] "."]
    if { $host eq "" } { return 0 }
    if { [class match -- $host equals ai_inference_hosts] } { return 1 }
    if { [class match -- $host ends_with ai_inference_suffixes] } { return 1 }
    set first_label [lindex [split $host "."] 0]
    set remainder [string range $host [string length $first_label] end]
    foreach suffix [class names ai_inference_label_suffixes] {
        set suffix_domain [string range $suffix [string first "." $suffix] end]
        set suffix_label [string range $suffix 0 [expr {[string first "." $suffix] - 1}]]
        if { $remainder eq $suffix_domain && [string length $first_label] > [string length $suffix_label]
             && [string range $first_label end-[expr {[string length $suffix_label] - 1}] end] eq $suffix_label } {
            return 1
        }
    }
    return 0
}

proc ai_inference_path_blocked { host path } {
    set host [string trimright [string tolower $host] "."]
    foreach entry [class names ai_inference_url_paths] {
        set slash [string first "/" $entry]
        if { $host eq [string range $entry 0 [expr {$slash - 1}]] } {
            set pattern "[string range $entry $slash end]*"
            if { [string match $pattern $path] } { return 1 }
        }
    }
    return 0
}

when CLIENT_ACCEPTED priority 100 {
    set ai_collected 0
    TCP::collect
}

when CLIENT_DATA priority 100 {
    set ai_payload [TCP::payload]
    set ai_length [string length $ai_payload]
    if { $ai_length < 5 } {
        if { $ai_collected == 0 } { set ai_collected 1; TCP::collect 5; return }
        TCP::release
        return
    }
    binary scan $ai_payload cSS ai_record_type ai_record_version ai_record_length
    set ai_record_type [expr {$ai_record_type & 0xff}]
    set ai_record_length [expr {$ai_record_length & 0xffff}]
    if { $ai_record_type != 22 } {
        TCP::release
        return
    }
    set ai_needed [expr {5 + $ai_record_length}]
    if { $ai_length < $ai_needed && $ai_collected < 2 } {
        set ai_collected 2
        TCP::collect $ai_needed
        return
    }
    set ai_sni ""
    binary scan $ai_payload @5c ai_handshake_type
    if { [expr {$ai_handshake_type & 0xff}] == 1 } {
        # Skip record header (5), handshake header (4), client version (2), random (32).
        set offset 43
        binary scan $ai_payload @${offset}c ai_len
        set offset [expr {$offset + 1 + ($ai_len & 0xff)}]
        binary scan $ai_payload @${offset}S ai_len
        set offset [expr {$offset + 2 + ($ai_len & 0xffff)}]
        binary scan $ai_payload @${offset}c ai_len
        set offset [expr {$offset + 1 + ($ai_len & 0xff)}]
        if { [binary scan $ai_payload @${offset}S ai_ext_total] == 1 } {
            set offset [expr {$offset + 2}]
            set ai_ext_end [expr {$offset + ($ai_ext_total & 0xffff)}]
            if { $ai_ext_end > $ai_length } { set ai_ext_end $ai_length }
            while { $offset + 4 <= $ai_ext_end } {
                binary scan $ai_payload @${offset}SS ai_ext_type ai_ext_len
                set ai_ext_type [expr {$ai_ext_type & 0xffff}]
                set ai_ext_len [expr {$ai_ext_len & 0xffff}]
                if { $ai_ext_type == 0 } {
                    # server_name_list length (2), name_type (1), host_name length (2), host_name.
                    if { [binary scan $ai_payload @[expr {$offset + 7}]S ai_name_len] == 1 } {
                        set ai_name_len [expr {$ai_name_len & 0xffff}]
                        binary scan $ai_payload @[expr {$offset + 9}]a${ai_name_len} ai_sni
                    }
                    break
                }
                set offset [expr {$offset + 4 + $ai_ext_len}]
            }
        }
    }
    if { $ai_sni ne "" && [call ai_inference_host_blocked $ai_sni] } {
        log local0.notice "AI inference TLS blocked: client=[IP::client_addr] sni=$ai_sni"
        reject
        return
    }
    TCP::release
}
