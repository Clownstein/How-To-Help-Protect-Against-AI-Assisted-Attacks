# Generated by tools/generate.py from catalog/catalog.json. Do not edit by hand.
# AI inference egress iRule for BIG-IP forward proxy and SSL Orchestrator deployments.
# Requires the data groups from ai-inference-datagroups.tmsh. Attach to a virtual server with an
# HTTP profile (explicit proxy) and, for TLS inspection, a client SSL profile.

proc ai_inference_host_blocked { host } {
    set host [string trimright [string tolower $host] "."]
    if { $host eq "" } { return 0 }
    if { [class match -- $host equals ai_inference_hosts] } { return 1 }
    if { [class match -- $host ends_with ai_inference_suffixes] } { return 1 }
    set first_label [lindex [split $host "."] 0]
    set remainder [string range $host [string length $first_label] end]
    foreach suffix [class names ai_inference_label_suffixes] {
        set suffix_domain [string range $suffix [string first "." $suffix] end]
        set suffix_label [string range $suffix 0 [expr {[string first "." $suffix] - 1}]]
        if { $remainder eq $suffix_domain && [string length $first_label] > [string length $suffix_label]
             && [string range $first_label end-[expr {[string length $suffix_label] - 1}] end] eq $suffix_label } {
            return 1
        }
    }
    return 0
}

proc ai_inference_path_blocked { host path } {
    set host [string trimright [string tolower $host] "."]
    foreach entry [class names ai_inference_url_paths] {
        set slash [string first "/" $entry]
        if { $host eq [string range $entry 0 [expr {$slash - 1}]] } {
            set pattern "[string range $entry $slash end]*"
            if { [string match $pattern $path] } { return 1 }
        }
    }
    return 0
}

when CLIENTSSL_CLIENTHELLO priority 100 {
    if { [SSL::extensions exists -type 0] } {
        binary scan [SSL::extensions -type 0] {@9A*} ai_sni
        if { [call ai_inference_host_blocked $ai_sni] } {
            log local0.notice "AI inference TLS blocked: client=[IP::client_addr] sni=$ai_sni"
            reject
            event disable all
        }
    }
}

when HTTP_REQUEST priority 100 {
    if { [HTTP::method] eq "CONNECT" } {
        set ai_host [lindex [split [HTTP::uri] ":"] 0]
    } else {
        set ai_host [lindex [split [HTTP::host] ":"] 0]
    }
    if { [call ai_inference_host_blocked $ai_host] } {
        log local0.notice "AI inference HTTP blocked: client=[IP::client_addr] host=$ai_host"
        HTTP::respond 403 content "Access to hosted AI inference services is blocked by policy." "Content-Type" "text/plain" "Connection" "close"
        event disable all
        return
    }
    if { [HTTP::method] ne "CONNECT" && [call ai_inference_path_blocked $ai_host [HTTP::path]] } {
        log local0.notice "AI inference path blocked: client=[IP::client_addr] host=$ai_host path=[HTTP::path]"
        HTTP::respond 403 content "Access to hosted AI inference services is blocked by policy." "Content-Type" "text/plain" "Connection" "close"
        event disable all
    }
}
